{
  "name": "mote-ui-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "description": "Mote UI — a lightweight mobile Vue 3 component library borrowing Element Plus design tokens",
  "scripts": {
    "dev": "pnpm --filter @mote-ui/docs dev",
    "build": "pnpm --filter @mote-ui/icons build && pnpm --filter mote-ui build",
    "build:docs": "pnpm --filter @mote-ui/docs build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write . --log-level warn",
    "typecheck": "vue-tsc --noEmit -p packages/mote-ui/tsconfig.json",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.31.0",
    "happy-dom": "^15.11.6",
    "postcss-px-to-viewport-8-plugin": "^1.2.5",
    "prettier": "^3.3.3",
    "sass": "^1.80.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.5",
    "vue": "^3.5.12",
    "vue-tsc": "^2.1.10"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  }
}
